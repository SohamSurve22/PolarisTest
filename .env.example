# ==========================================
# PolarisLex Environment Configuration Template
# Copy this file to .env and adjust as necessary
# ==========================================

# ------------------------------------------
# Core App & LLM Configuration (Ollama)
# ------------------------------------------
# Ollama service endpoint for host execution (in Docker Compose, use http://host.docker.internal:11434)
POLARIS_OLLAMA_URL=http://localhost:11434

# Primary LLM for report summaries and statute Q&A (rag)
POLARIS_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M

# Directory containing law JSON files (defaults to repository root if empty)
POLARIS_LAW_DIR=

# Maximum number of priority gaps returned in client memo reports
POLARIS_PRIORITY_GAPS_CAP=5

# Directory to persist memo report JSON files (leave empty to disable persistence)
POLARIS_REPORT_DIR=

# ------------------------------------------
# Vectorization Pipeline Settings (Pydantic: VECTORIZATION_)
# ------------------------------------------
VECTORIZATION_APP_NAME=PolarisLex Vectorization
VECTORIZATION_LOG_LEVEL=INFO
VECTORIZATION_QDRANT_URL=http://localhost:6333
VECTORIZATION_QDRANT_COLLECTION=document_clauses
VECTORIZATION_OLLAMA_URL=http://localhost:11434/api/embeddings
VECTORIZATION_EMBEDDING_MODEL=nomic-embed-text
VECTORIZATION_EMBEDDING_DIM=768
VECTORIZATION_EMBEDDING_BACKEND=ollama
VECTORIZATION_EMBED_BATCH_SIZE=32
VECTORIZATION_DOCUMENT_EMBED_PREFIX="search_document: "
VECTORIZATION_QUERY_EMBED_PREFIX="search_query: "
VECTORIZATION_CLAUSES_DIR=document_pipeline/output
VECTORIZATION_KG_DIR=kg_export
VECTORIZATION_KG_MAX_TOKENS=300
VECTORIZATION_RAG_PATH=dataset/IT_ACT_POLARISLEX_MERGED.json
VECTORIZATION_BATCH_SIZE=50
VECTORIZATION_REQUEST_TIMEOUT_SECONDS=30.0
VECTORIZATION_SEARCH_TOP_K=10
VECTORIZATION_SEARCH_MIN_SCORE=0.55
VECTORIZATION_MIN_CLAUSE_TOKENS=5
VECTORIZATION_MAX_CLAUSE_TOKENS=512
VECTORIZATION_CHUNK_OVERLAP_TOKENS=50

# ------------------------------------------
# Document Intelligence Pipeline Settings (Pydantic: PIPELINE_)
# ------------------------------------------
PIPELINE_APP_NAME=PolarisLex Document Pipeline
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
PIPELINE_DATA_DIR=data
PIPELINE_UPLOADS_DIR=data/uploads
PIPELINE_PROCESSED_DIR=data/processed
PIPELINE_ENABLE_CLEANING=true
PIPELINE_ENABLE_SECTION_EXTRACTION=true
PIPELINE_ENABLE_CLAUSE_EXTRACTION=true
PIPELINE_ENABLE_LLM_PREPARATION=true

# ------------------------------------------
# Neo4j Knowledge Graph Settings
# ------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=polarislex
NEO4J_AUTH=neo4j/polarislex

# ------------------------------------------
# Optional External Services / OpenAI JEV Integration
# ------------------------------------------
OPENAI_API_KEY=
OPENAI_DECISIONS_PREVIEW_URL=https://decisions.preview.openai.com/v1/decisions
OPENAI_DECISIONS_PREVIEW_MODEL=gpt-6-luna
OPENAI_DECISIONS_TRY_COUNT=2
JEV_CHAT_MODEL=gpt-4o-mini
